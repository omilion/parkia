# Production runtime.
NODE_ENV="production"

# Public HTTPS URL used by browsers and CORS protection.
APP_URL="https://app.parkia.cl"

# Optional comma-separated list for extra browser origins.
# APP_URL already covers the main domain.
TRUSTED_ORIGINS=""

# HTTP server binding.
PORT="8080"
# Bind locally when nginx/Caddy exposes HTTPS.
HOST="127.0.0.1"

# Base de datos: PostgreSQL 16 (ver docs/POSTGRES.md).
PARKIA_DB_ENGINE="postgres"
# Conexion de la app: rol parkia_app, SIN BYPASSRLS (el aislamiento por empresa lo aplica la base).
DATABASE_URL="postgresql://parkia_app:CAMBIAR@127.0.0.1:5432/parkia"
# Rol administrador: migraciones al arrancar, trabajos de plataforma y respaldos (pg_dump).
PARKIA_PG_ADMIN_URL="postgresql://parkia_admin:CAMBIAR@127.0.0.1:5432/parkia"
# El rol parkia_app lo crea deploy/postgres/init-roles.sql; la app no intenta crearlo.
PARKIA_PG_CREATE_APP_ROLE="false"
# Tamano de los pools de conexion (app y administrador).
PARKIA_PG_POOL_SIZE="20"
PARKIA_PG_ADMIN_POOL_SIZE="5"

# Solo para la migracion inicial desde SQLite (scripts/migrate-sqlite-to-pg.ts).
# PARKIA_DB_PATH="/var/lib/parkia/parkia.db"

# Persistent absolute paths. Adjust these to the real server volume.
PARKIA_STORAGE_PATH="/var/lib/parkia/storage"
PARKIA_BACKUP_PATH="/var/backups/parkia"

# Never seed demo data in production.
PARKIA_SEED_DEMO="false"

# Platform administrators: comma-separated staff emails (admin role required)
# allowed to manage full database backups (all tenants) and to see
# infrastructure details. Leave empty to disable those endpoints for everyone.
# Example: "ops@parkia.cl,soporte@parkia.cl". Never list a customer account.
PARKIA_PLATFORM_ADMINS=""

# Master key that encrypts per-tenant secrets (SII digital certificates, CAF files,
# payment gateway credentials). 32 bytes in base64. REQUIRED in production.
# Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it outside the database and its backups. Losing it makes stored certificates unreadable.
PARKIA_MASTER_KEY=""

# Habilita la emision de documentos tributarios REALES contra el SII (produccion).
# Sin esta variable las empresas solo pueden operar en certificacion (Maullin).
# Activala recien cuando el servidor este listo para emitir con validez tributaria.
# PARKIA_SII_ALLOW_PRODUCTION="true"

# Correo saliente: OBLIGATORIO en produccion (recuperacion de clave, verificacion de cuentas, avisos de cobranza).
# Elige un transporte y verifica el dominio del remitente (SPF/DKIM) en el proveedor. Ver docs/MAIL.md.
PARKIA_MAIL_TRANSPORT="resend"   # smtp | resend
PARKIA_MAIL_FROM="Parkia <no-reply@tu-dominio.cl>"
# RESEND_API_KEY=""
# PARKIA_SMTP_URL="smtps://usuario:clave@smtp.ejemplo.com:465"
