# Production runtime.
NODE_ENV="production"

# Public HTTPS URL used by browsers and CORS protection.
APP_URL="https://app.parkia.cl"

# Optional comma-separated list for extra browser origins.
# APP_URL already covers the main domain.
TRUSTED_ORIGINS=""

# HTTP server binding.
PORT="8080"
# Bind locally when nginx/Caddy exposes HTTPS.
HOST="127.0.0.1"

# Persistent absolute paths. Adjust these to the real server volume.
PARKIA_DB_PATH="/var/lib/parkia/parkia.db"
PARKIA_STORAGE_PATH="/var/lib/parkia/storage"
PARKIA_BACKUP_PATH="/var/backups/parkia"

# Never seed demo data in production.
PARKIA_SEED_DEMO="false"
