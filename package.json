{
  "name": "parkia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "seed:demo:deep": "tsx scripts/seed-demo-deep.ts",
    "purge:demo:deep": "tsx scripts/purge-demo-deep.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:sqlite-to-pg": "tsx scripts/migrate-sqlite-to-pg.ts",
    "lint": "tsc --noEmit && npm run lint:promises",
    "lint:promises": "eslint \"server/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "test": "tsx tests/api.test.ts",
    "test:unit": "tsx --test tests/pricing/engine.test.ts tests/payments/gateway.test.ts tests/mail/mail.test.ts tests/operator/offline-queue.test.ts tests/operator/printing.test.ts tests/operator/scanning.test.ts tests/observability/error-reporting.test.ts tests/observability/backup-files.test.ts",
    "test:operator": "tsx --test tests/operator/operator-sync.test.ts",
    "test:operator:pglite": "cross-env PARKIA_DB_ENGINE=pglite tsx --test tests/operator/operator-sync.test.ts",
    "test:jobs": "tsx --test tests/jobs/*.test.ts tests/auth/*.test.ts tests/dates/*.test.ts",
    "test:jobs:pglite": "cross-env PARKIA_DB_ENGINE=pglite tsx --test tests/jobs/*.test.ts tests/auth/*.test.ts tests/dates/*.test.ts",
    "test:phase7": "tsx --test tests/phase7/*.test.ts",
    "test:phase7:pglite": "cross-env PARKIA_DB_ENGINE=pglite tsx --test tests/phase7/*.test.ts",
    "test:saas": "tsx --test tests/saas/*.test.ts",
    "test:saas:pglite": "cross-env PARKIA_DB_ENGINE=pglite tsx --test tests/saas/*.test.ts",
    "test:dte": "tsx --test tests/dte/core.test.ts tests/dte/sii-client.test.ts tests/dte/migration.test.ts tests/dte/service.test.ts",
    "dte:smoke": "tsx scripts/dte-smoke.ts",
    "test:pglite": "cross-env PARKIA_DB_ENGINE=pglite tsx tests/api.test.ts",
    "test:dte:pglite": "cross-env PARKIA_DB_ENGINE=pglite tsx --test tests/dte/service.test.ts",
    "test:postgres": "cross-env PARKIA_DB_ENGINE=postgres tsx tests/api.test.ts",
    "test:e2e:pglite": "cross-env PARKIA_DB_ENGINE=pglite playwright test",
    "test:e2e:postgres": "cross-env PARKIA_DB_ENGINE=postgres playwright test",
    "smoke:api": "tsx scripts/smoke-api.ts",
    "db:compare-schemas": "tsx scripts/compare-schemas.ts",
    "verify": "npm run lint && npm run build && npm test && npm run test:unit && npm run test:operator && npm run test:saas && npm run test:phase7 && npm run test:jobs && npm run test:dte && npm run db:compare-schemas && npm run test:pglite && npm run test:operator:pglite && npm run test:saas:pglite && npm run test:phase7:pglite && npm run test:jobs:pglite && npm run test:dte:pglite",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@sentry/node": "^11.12.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.107.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3": "^12.6.2",
    "bwip-js": "^4.11.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.10",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "iconv-lite": "^0.7.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-forge": "^1.4.3",
    "nodemailer": "^6.9.16",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "xml-crypto": "^6.4.0",
    "xmllint-wasm": "^5.3.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.1.14",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.0.3",
    "workbox-window": "^7.3.0"
  }
}
