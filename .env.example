# Development/local template. For production use .env.production.example.
NODE_ENV="development"

# APP_URL: Public URL where this app is hosted.
APP_URL="MY_APP_URL"

# Optional comma-separated list of additional allowed browser origins.
TRUSTED_ORIGINS=""

# HTTP server binding.
PORT="8080"
HOST="0.0.0.0"

# SQLite database path. Defaults to ./parkia.db when omitted.
PARKIA_DB_PATH="parkia.db"

# Local file storage path. Defaults to ./storage when omitted.
PARKIA_STORAGE_PATH="storage"

# Local database backup destination. Defaults to ./backups when omitted.
PARKIA_BACKUP_PATH="backups"

# Seed demo data automatically. Defaults to true outside production and false in production.
PARKIA_SEED_DEMO="true"
