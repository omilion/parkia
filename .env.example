# Development/local template. For production use .env.production.example.
NODE_ENV="development"

# APP_URL: Public URL where this app is hosted.
APP_URL="MY_APP_URL"

# Optional comma-separated list of additional allowed browser origins.
TRUSTED_ORIGINS=""

# HTTP server binding.
PORT="8080"
HOST="0.0.0.0"

# Database engine: "sqlite" (default for local development), "postgres" (production) or
# "pglite" (embedded PostgreSQL, used by the test suites). See docs/POSTGRES.md.
PARKIA_DB_ENGINE="sqlite"

# SQLite database path. Defaults to ./parkia.db when omitted.
PARKIA_DB_PATH="parkia.db"

# PostgreSQL (when PARKIA_DB_ENGINE=postgres). Local server: docker compose up -d postgres
# DATABASE_URL="postgresql://parkia_app:parkia_app_dev@127.0.0.1:5432/parkia"
# PARKIA_PG_ADMIN_URL="postgresql://parkia_admin:parkia_admin_dev@127.0.0.1:5432/parkia"

# Local file storage path. Defaults to ./storage when omitted.
PARKIA_STORAGE_PATH="storage"

# Local database backup destination. Defaults to ./backups when omitted.
PARKIA_BACKUP_PATH="backups"

# Seed demo data automatically. Defaults to true outside production and false in production.
PARKIA_SEED_DEMO="true"

# Platform administrators: comma-separated staff emails allowed to list, create,
# download and restore full database backups and to see infrastructure details
# (disk paths, global readiness checks). The user must also have the admin role.
# Tenant admins that are not listed here get 403 PLATFORM_ADMIN_REQUIRED.
PARKIA_PLATFORM_ADMINS="admin@parkia.local"

# Master key for per-tenant secrets (SII certificates, CAF). Optional in development:
# without it a fixed development key is used. Never reuse the production key here.
PARKIA_MASTER_KEY=""

# Allows tenants to emit REAL tax documents against the SII production environment.
# Leave it unset in development and staging: tenants can then only use the certification (Maullin) environment.
# PARKIA_SII_ALLOW_PRODUCTION="true"
