SHELL=/bin/bash
# Las variables (PARKIA_PG_ADMIN_URL, PARKIA_STORAGE_PATH, PARKIA_BACKUP_PATH) salen del mismo
# archivo de entorno del servicio.
BASH_ENV=/etc/parkia/parkia.env

# PostgreSQL (motor de produccion): volcado + archivos adjuntos, diario a las 03:30.
30 3 * * * parkia set -a; . /etc/parkia/parkia.env; set +a; /opt/parkia/current/scripts/backup-postgres.sh >> /var/log/parkia-backup.log 2>&1

# SQLite (solo instalaciones que aun no migran a PostgreSQL): descomentar estas lineas.
# 15 3 * * * parkia /opt/parkia/current/scripts/backup-sqlite.sh >> /var/log/parkia-backup.log 2>&1
# 30 3 * * * parkia /opt/parkia/current/scripts/backup-data.sh >> /var/log/parkia-backup.log 2>&1
