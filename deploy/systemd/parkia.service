[Unit]
Description=Parkia web application
After=network.target

[Service]
Type=simple
User=parkia
Group=parkia
WorkingDirectory=/opt/parkia/current
EnvironmentFile=/etc/parkia/parkia.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/parkia /var/backups/parkia /opt/parkia/current

[Install]
WantedBy=multi-user.target
